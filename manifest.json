{
  "manifest_version": 3,
  "name": "QualityBuffer",
  "short_name": "QualityBuffer",
  "version": "2.2.2",
  "description": "Unlocks multi-minute 4K YouTube pre-buffering, hardware VP9 decoding, and high-speed HLS/MP4 web video downloading.",
  "author": "Joao Vitor Magalhaes Alves (https://github.com/Alves404)",
  "homepage_url": "https://github.com/Alves404/QualityBuffer",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "QualityBuffer - Video Optimizer & Downloader",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "webRequest",
    "downloads"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.googlevideo.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "src/content/page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "css": [
        "src/content/player-optimize.css"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "src/core/utils.js",
        "src/core/hls-downloader.js",
        "src/content/content-controller.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ]
}
