{
  "manifest_version": 3,
  "name": "My Quality 4k",
  "short_name": "MyQuality4k",
  "version": "2.1.0",
  "description": "Unlocks multi-minute 4K YouTube pre-buffering, MSE buffer stability, and hardware VP9 codec selection for smooth playback.",
  "author": "Joao Vitor Magalhaes Alves (https://github.com/Alves404) — AI-Assisted Development by Gemini 4 Argon",
  "homepage_url": "https://github.com/Alves404/My-Quality-4k",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "My Quality 4k - Buffer & Hardware Optimizer",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.googlevideo.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "src/content/page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "src/content/content-controller.js"
      ],
      "css": [
        "src/content/player-optimize.css"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
